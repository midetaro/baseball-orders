#!/bin/sh
set -eu

before_diff="$(mktemp "${TMPDIR:-/tmp}/baseball-orders-pre-commit.XXXXXX")"
after_diff="$(mktemp "${TMPDIR:-/tmp}/baseball-orders-pre-commit.XXXXXX")"
trap 'rm -f "$before_diff" "$after_diff"' EXIT HUP INT TERM

git diff --no-ext-diff --binary -- > "$before_diff"
./gradlew spotlessApply clean test
git diff --no-ext-diff --binary -- > "$after_diff"

if ! cmp -s "$before_diff" "$after_diff"; then
    echo 'Spotless changed files. Stage the formatted changes and commit again.' >&2
    exit 1
fi
