{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmitOnError": true,
    "removeComments": false,
    "rootDir": "src/main/typescript",
    "outDir": "build/generated/typescript/static/js"
  },
  "include": ["src/main/typescript/**/*.ts"]
}
